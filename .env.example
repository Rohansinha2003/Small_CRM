# --- Required in production ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Razorpay (https://dashboard.razorpay.com -> Settings -> API Keys / Webhooks) ---
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
# Webhook URL to register in Razorpay: https://YOUR-DOMAIN/api/billing/webhook   (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# --- Platform ---
# Comma-separated emails that can open /admin (must also have a normal account)
ADMIN_EMAILS=you@yourcompany.com
# Number of free full-access pilot workspaces (first N signups). Default 5.
PILOT_SLOTS=5
# Optional: sign-ups allowed per IP per hour (default 10)
# SIGNUP_RATE_MAX=10

# --- Ops ---
# Protects /api/cron/cleanup (Vercel Cron sends it automatically). Generate: openssl rand -hex 32
CRON_SECRET=
# Public URL, used for SEO/sitemap
NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Legal pages (Terms/Privacy/Refund/Contact). Razorpay checks these during activation. Set BEFORE building. ---
COMPANY_NAME=ChatDesk
COMPANY_LEGAL_NAME=Your Registered Business Name
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_PHONE=+91 XXXXX XXXXX
COMPANY_ADDRESS=Your registered address, City, State, PIN
